{
  "name": "portfolio-root",
  "version": "1.0.0",
  "description": "Root configuration for PostgreSQL developer portfolio website",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "install-backend": "npm install --prefix backend",
    "install-frontend": "npm install --include=dev --prefix frontend",
    "build-frontend": "cd frontend && npm run build",
    "build": "npm install && cd frontend && npm run build",
    "start": "node backend/server.js"
  }
}
